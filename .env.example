# Independent token created for this repository's own bot
BOT_TOKEN=replace_with_this_bots_token
# Numeric Telegram user ID allowed to administer this bot
OWNER_ID=123456789
# Optional username without @; startup verifies it matches BOT_TOKEN
BOT_USERNAME=your_bot_username
# Optional; used only by the automation bot
BOT_STATE_FILE=data/state.json
LOG_LEVEL=INFO
